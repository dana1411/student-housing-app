{
  "name": "student-housing-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-sql.mjs && vite build",
    "preview": "vite preview",
    "sql": "node scripts/build-sql.mjs",
    "test:db": "node scripts/build-sql.mjs && node --test tests/db/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test": "npm run test:db && npm run test:e2e",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@electric-sql/pglite": "0.5.11",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "jspdf": "4.2.1",
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "pg": "8.23.1",
    "vite": "8.3.5"
  }
}
