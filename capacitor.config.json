{
  "appId": "com.lodgely.app",
  "appName": "Lodgely",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 8000,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#1B2A6B",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
